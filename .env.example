# ==============================================================================
# HireSense AI - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NOTE: Never commit '.env' with real credentials to source control!
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/hiresense_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Server Port
SERVER_PORT=8080

# Optional: Google Gemini AI API Key (Leave empty to use deterministic analyzer)
GEMINI_API_KEY=
